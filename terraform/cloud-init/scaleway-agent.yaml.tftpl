#cloud-config
# k3s agent bootstrap on Scaleway.
# Templated vars: k3s_version, k3s_token, server_url, network_cidr.
#
# UNVERIFIED FIRST DRAFT — see scaleway-control-plane.yaml.tftpl for the
# caveats on interface auto-detection and the metadata-service assumption;
# both apply here identically.
package_update: true
packages:
  - curl

write_files:
  # Image GC thresholds (kubelet defaults are 85/80). k3s v1.36's kubelet no
  # longer accepts --image-gc-*-threshold-percent as flags ("unknown flag"),
  # so they go in a kubelet config drop-in that k3s loads from this dir.
  - path: /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/10-image-gc.conf
    permissions: "0644"
    content: |
      apiVersion: kubelet.config.k8s.io/v1beta1
      kind: KubeletConfiguration
      imageGCHighThresholdPercent: 70
      imageGCLowThresholdPercent: 60

runcmd:
  - |
    # Private NIC may attach after boot: retry 5m; non-empty PUBLIC_IFACE stops ^(lo|)$ picking the public NIC.
    PUBLIC_IFACE=""
    PRIVATE_IFACE=""
    for i in $(seq 1 60); do
      PUBLIC_IFACE=$(ip -o -4 route show default | awk '{print $5}' | head -n1)
      if [ -n "$PUBLIC_IFACE" ]; then
        PRIVATE_IFACE=$(ls /sys/class/net | grep -v -E "^(lo|$PUBLIC_IFACE)$" | head -n1)
        [ -n "$PRIVATE_IFACE" ] && break
      fi
      sleep 5
    done
    if [ -z "$PUBLIC_IFACE" ] || [ -z "$PRIVATE_IFACE" ]; then
      echo "FATAL: could not identify the public/private interfaces after 5m (public='$PUBLIC_IFACE', found: $(ls /sys/class/net | tr '\n' ' '))" >&2
      exit 1
    fi
    cat > /etc/netplan/60-private.yaml <<NETPLAN
    network:
      version: 2
      ethernets:
        $PRIVATE_IFACE:
          dhcp4: true
    NETPLAN
    chmod 600 /etc/netplan/60-private.yaml
    netplan apply
    for i in $(seq 1 60); do
      ip -o -4 addr show "$PRIVATE_IFACE" 2>/dev/null | grep -q inet && break
      sleep 2
    done

    NODE_IP=""
    for i in $(seq 1 30); do
      NODE_IP=$(ip -o -4 addr show "$PRIVATE_IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
      [ -n "$NODE_IP" ] && break
      sleep 2
    done
    [ -n "$NODE_IP" ] || { echo "FATAL: could not determine private IPv4 on $PRIVATE_IFACE" >&2; exit 1; }

    # kubelet's own defaults (85% high / 80% low) don't start reclaiming
    # unused container images until disk usage is already within a few
    # percent of the DiskPressure eviction threshold — fine on a big disk,
    # but on a small node it leaves almost no margin between "start
    # collecting garbage" and "start evicting pods". Lowered so image GC
    # kicks in with real headroom to spare.
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_CHANNEL="${k3s_version}" \
      K3S_URL="${server_url}" \
      K3S_TOKEN="${k3s_token}" \
      sh -s - agent \
        --kubelet-arg=cloud-provider=external \
        --node-ip=$NODE_IP \
        --flannel-iface=$PRIVATE_IFACE
  - until systemctl is-active --quiet k3s-agent; do sleep 5; done
  - touch /tmp/k3s-ready
