# ── Secrets & environment ───────────────────────────────────────────────
.env
*.env
!.env.example
secrets.yaml
secrets.yml
!secrets.example.yaml
!secrets.example.yml
# The two rules above match by basename ANYWHERE, so they also swallowed
# charts/health-stack/templates/secrets.yaml — a Helm *template* (no real
# values) that rendered the credential Secrets. It sat untracked for weeks:
# terraform apply from a local checkout worked, fresh clones did not. Chart
# templates never hold real secrets (they render from values), so exempt them.
!charts/*/templates/secrets.yaml
!charts/*/templates/secrets.yml

# ── openFHIR license (vendor-provided, never commit) ────────────────────
docker/openfhir/license/*.json
openfhir-license.json

# ── HAPI interceptor JAR (fetched into the image at build time, never here) ──
# The Dockerfile downloads the pinned release asset directly; no local copy is
# a build input. Kept ignored so a stray/manual jar can't be committed.
docker/hapi/extra-classes/*.jar

# ── TLS certs (self-signed dev certs, generated locally) ────────────────
docker/nginx/certs/*.crt
docker/nginx/certs/*.key
docker/nginx/certs/*.pem
*.crt
*.key
*.pem
!**/tls.example.*

# ── Terraform ───────────────────────────────────────────────────────────
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
# .terraform.lock.hcl is deliberately NOT ignored — commit it so provider
# versions are pinned and reproducible across machines and CI (HashiCorp's
# own recommendation). Refresh it with `terraform init -upgrade`.

# ── Kubernetes ──────────────────────────────────────────────────────────
kubeconfig
kubeconfig.*
*.kubeconfig
k8s/base/secrets.yaml
k8s/base/secrets.yml

# ── Java / build artifacts ──────────────────────────────────────────────
*.class
*.log
target/
hs_err_pid*
replay_pid*

# ── Editor / OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
*.swp

# Local AI-assistant working files (never ship)
nimbalyst-local/
.nimbalyst/
